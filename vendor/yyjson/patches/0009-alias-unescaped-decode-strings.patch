+/* No-escape strings alias the caller buffer. Used only when the document
+ * has no '\\', so this never has to unescape. */
+static bool read_str_alias(u8 **ptr, u8 *eof, yyjson_read_flag flg,
+                           yyjson_val *val, const char **msg) {
+    if (*ptr >= eof || **ptr != '"') {
+        *msg = "unexpected character, expected a string";
+        return false;
+    }
+    u8 *start = *ptr + 1;
+    val->tag = 0;
+    if (!read_str_validate(ptr, eof, flg, val, msg)) return false;
+    u8 *quote = *ptr - 1;
+    u64 extra = val->tag & YYJSON_RESERVED_INVALID_UNICODE;
+    val->tag = ((u64)(quote - start) << YYJSON_TAG_BIT)
+        | YYJSON_TYPE_STR | YYJSON_SUBTYPE_NOESC | extra;
+    val->uni.str = (const char *)start;
+    return true;
+}
+
+static bool read_str_pick(u8 **ptr, u8 *eof, yyjson_read_flag flg,
+                          yyjson_val *val, const char **msg) {
+    if (has_flg(ALIAS_NOESC)) return read_str_alias(ptr, eof, flg, val, msg);
+    return read_str(ptr, eof, flg, val, msg);
+}
