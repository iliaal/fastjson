+                          yyjson_val *val, const char **msg, yyjson_alc *alc) {
+    if (has_flg(ALIAS_NOESC)) {
+        return read_num_bounded(cur, eof, pre, flg, val, msg, alc);
+    }
+    return read_num(cur, pre, flg, val, msg);
+}
+
+static bool read_true_pick(u8 **cur, u8 *eof, yyjson_read_flag flg, yyjson_val *val) {
